# Copy to .env and fill in.  A real environment variable always wins over this
# file, so hosts like Render only need the key set in their dashboard.

# Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=

# groq | ollama
V2V_LLM_BACKEND=groq
# groq | local
V2V_STT_BACKEND=groq
# gtts | edge | kokoro
V2V_TTS_ENGINE=gtts

# Optional
# V2V_GROQ_LLM_MODEL=llama-3.1-8b-instant
# V2V_GROQ_STT_MODEL=whisper-large-v3-turbo
# V2V_GTTS_TLD=co.uk
# V2V_EDGE_VOICE=en-GB-SoniaNeural
